# Copy to .env and fill in. .env is git-ignored and never committed.

# --- Required -------------------------------------------------------------
# Your OpenAI API key. Without it, /chat returns 503 and /health is "degraded".
OPENAI_API_KEY=sk-your-key-here

# --- Model ----------------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini

# Leave OPENAI_BASE_URL unset to use OpenAI itself. To use any other
# OpenAI-compatible provider, put THEIR key in OPENAI_API_KEY above and set
# the base URL plus a model that supports tool calling. For example, Groq:
#
#   OPENAI_API_KEY=gsk_your_groq_key
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
#
# OpenRouter, Together and a local Ollama/vLLM server work the same way.
OPENAI_BASE_URL=
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# --- Internal customer backend -------------------------------------------
# The mock backend is served by this same app, so it points at itself.
# In a real deployment this would be another service's URL.
BACKEND_BASE_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT_SECONDS=5

# Demo switch for exercising error handling without touching code:
#   none | timeout | server_error | malformed
BACKEND_FAILURE_MODE=none

# --- Agent behaviour ------------------------------------------------------
AGENT_MAX_ITERATIONS=4
HISTORY_MAX_MESSAGES=12
SESSION_TTL_SECONDS=3600

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
